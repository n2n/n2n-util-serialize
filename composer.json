{
    "name": "n2n/n2n-util-serialize",
    "type": "library",
    "description": "Safely serialize and unserialize plain data objects using PHP's native serialize()/unserialize() with an allowed_classes allowlist derived from the class structure, preventing object-injection and POP-chain attacks.",
    "keywords": [
        "n2n",
        "serialize",
        "unserialize",
        "security",
        "allowed-classes",
        "deserialization",
        "pop-chain"
    ],
    "homepage": "https://n2n.rocks/",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Andreas von Burg",
            "email": "a@von-burg.net",
            "homepage": "https://www.von-burg.net/"
        }
    ],
    "support": {
        "email": "a@von-burg.net"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "n2n/n2n-spec-valobj": "~1.0.0",
        "n2n/n2n-util": "~7.5.0"
    },
    "require-dev": {
        "php": ">=8.4",
        "n2n/n2n-test": "~7.5.0",
        "phpunit/phpunit": "^9.6.26"
    },
    "config": {
        "vendor-dir": "src/vendor"
    },
    "autoload": {
        "psr-4": {
            "n2n\\util\\serialize\\": "src/app/n2n/util/serialize"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "n2n\\util\\serialize\\": "src/test/n2n/util/serialize"
        }
    }
}